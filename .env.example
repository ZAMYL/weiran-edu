# Backend only. No credentials are needed for this foundation.
# Values: development, test, production.
WEIRAN_EDU_ENV=development
# The app does not load .env files implicitly.
# To opt in: uv run --env-file ../../.env --locked uvicorn app.main:create_app --factory
# Never put private keys, student data, or credentials in NEXT_PUBLIC_* variables.

# Optional server-only Qwen Synthetic Live. No implicit region and no automatic API calls.
# Fill DASHSCOPE_BASE_URL from YOUR workspace console; never guess a WorkspaceId.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
WEIRAN_QWEN_MODEL=qwen3.8-flash
# json_schema is documented for qwen3.8-flash; json_object is an explicit alternative.
WEIRAN_QWEN_OUTPUT_MODE=json_schema
# These values do not enable live mode. The demo requires both explicit confirmation flags.

# Server-only LIVE-02 programming investigation. Both are required; absent values
# make the formal task fail closed with AI_LIVE_ADMISSION_REQUIRED.
WEIRAN_EDU_PROGRAMMING_LIVE_APPROVAL=
# Absolute, outside the repository. One journal per approved campaign.
WEIRAN_EDU_CAMPAIGN_LEDGER_ROOT=
