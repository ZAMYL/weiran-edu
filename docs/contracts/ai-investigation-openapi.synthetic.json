      },
      "ExactRational": {
        "properties": {
          "numerator": {
            "$ref": "#/components/schemas/ExactNumerator"
          },
          "denominator": {
            "$ref": "#/components/schemas/ExactDenominator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "numerator",
          "denominator"
        ],
        "title": "ExactRational"
      },
      "ExactNumerator": {
        "anyOf": [
          {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": -9007199254740991.0
          },
          {
            "type": "string",
            "maxLength": 1025,
            "pattern": "^-?(?:9007199254740992|[1-9][0-9]{16,1023}|9[1-9][0-9]{14}|90[1-9][0-9]{13}|900[8-9][0-9]{12}|9007[2-9][0-9]{11}|9007199[3-9][0-9]{8}|90071992[6-9][0-9]{7}|900719925[5-9][0-9]{6}|9007199254[8-9][0-9]{5}|90071992547[5-9][0-9]{4}|900719925474[1-9][0-9]{3}|900719925474099[3-9])$"
          }
        ]
      },
      "ExactDenominator": {
        "anyOf": [
          {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 1.0
          },
          {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(?:9007199254740992|[1-9][0-9]{16,1023}|9[1-9][0-9]{14}|90[1-9][0-9]{13}|900[8-9][0-9]{12}|9007[2-9][0-9]{11}|9007199[3-9][0-9]{8}|90071992[6-9][0-9]{7}|900719925[5-9][0-9]{6}|9007199254[8-9][0-9]{5}|90071992547[5-9][0-9]{4}|900719925474[1-9][0-9]{3}|900719925474099[3-9])$"
          }
        ]
      },
