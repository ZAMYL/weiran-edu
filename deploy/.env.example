# Copy to deploy/.env and chmod 600. Never commit the real file.
DOMAIN=edu.example.com

# Server-owned credentials (never NEXT_PUBLIC_*).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WEIRAN_QWEN_MODEL=qwen3.8-flash

# Optional: only the API/worker containers read these.
WEIRAN_EDU_DATABASE=/data/edu.sqlite3
WEIRAN_EDU_AI_STATE_DIR=/data/ai-state
WEIRAN_EDU_CAMPAIGN_LEDGER_ROOT=/ledger
WEIRAN_EDU_REAL_DATA_APPROVAL=/run/secrets/real-data-approval.json
WEIRAN_EDU_QWEN_LIVE_APPROVAL=/run/secrets/qwen-live-approval.json

# LIVE-02 programming task approval (one campaign per file). Only api and
# programming_worker read this path; never expose it to the web container.
WEIRAN_EDU_PROGRAMMING_LIVE_APPROVAL=/run/secrets/programming-live-approval.json
